{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/types.ts",
    "src/components/*.tsx",
    "src/data/*.ts",
    "src/utils/*.ts",
    "vite.config.ts"
  ]
}
