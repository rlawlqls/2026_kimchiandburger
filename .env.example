# Google Cloud Vision API key — used ONLY by the Vercel serverless function (api/ocr.js).
# Never expose this in the frontend. On Vercel, set it in Project Settings → Environment Variables.
GCP_VISION_KEY=your-google-cloud-vision-api-key

# Google Gemini (free tier) API key — used ONLY by the serverless function (api/gemini.js)
# to suggest vendor questions. Optional: when unset, the app falls back to static
# suggestions. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
