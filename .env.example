# Google Cloud Vision API key — used ONLY by the serverless function api/vision.js.
# This is the PRIMARY OCR path: ~0.5s per image and true pixel bounding boxes.
# Setup: console.cloud.google.com → enable "Cloud Vision API" → APIs & Services →
# Credentials → Create credentials → API key. Restrict the key to Cloud Vision API
# only. Do NOT add an HTTP-referrer restriction: the key is used server-side, so a
# referrer rule would block it. When unset, /api/vision returns 503 and the app
# falls back to /api/ocr (Gemma) and then to browser-side Tesseract.
GCP_VISION_KEY=

# Google Gemini (AI Studio) API key — used ONLY by the serverless function api/ocr.js
# for menu-board OCR (Gemma vision). Never expose it in the frontend. On Vercel, set
# it in Project Settings → Environment Variables. When unset, /api/ocr returns 503 and
# the app falls back to browser-side Tesseract.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: comma-separated origins allowed to call /api/ocr, e.g.
#   https://scan-korean-chat.vercel.app,http://localhost:5173
# Leave unset to allow any origin (local development).
ALLOWED_ORIGINS=
